

<!---->



<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
    <meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1.0" />
    
      <title>Почта Mail.ru</title>
    

    
      <link nonce="<!--# echo var='csp_nonce' -->" rel="icon" sizes="16x16" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/16-fav_mail.png" />
      <link nonce="<!--# echo var='csp_nonce' -->" rel="icon" sizes="24x24" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/24-fav_mail.png" />
      <link nonce="<!--# echo var='csp_nonce' -->" rel="icon" sizes="32x32" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/32-fav_mail.png" />
      <link nonce="<!--# echo var='csp_nonce' -->" rel="icon" sizes="48x48" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/48-fav_mail.png" />
      <link nonce="<!--# echo var='csp_nonce' -->" rel="icon" sizes="192x192" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/icon-192-round.png" />
      <link nonce="<!--# echo var='csp_nonce' -->" rel="apple-touch-icon" sizes="192x192" href="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/icon-192.png" />
      <meta name="msapplication-TileImage" content="https://imgs2.imgsmail.ru/static/octavius/favicons/rebranding-2024/icon-512.png" />
    

		<style>
			
				html, body {
	background: white;
	padding: 0;
	margin: 0;
	font-family: Arial, Tahoma, Verdana, sans-serif;
	font-size: 13px;
}

body {
    height: 100%;
    min-height: 100vh;
}

body, textarea {
    font-family: 'San Francisco', Helvetica, Arial, Tahoma, Verdana, sans-serif;
}

body.vk-mail {
    background: #EDEEF0;
}

.vk-mail .error-message_sketch {
    background-color: #EDEEF0;
}

.vk-mail .w-pm-menu, .vk-mail .pm-menu {
    background: #ffffff;
}

.vk-mail .btn_main {
    color: #ffffff;
    background: #4986cc;
}

.vk-mail .btn_main:hover {
    background: #4681c6;
}

.vk-mail .error-message__footer {
    background: #ffffff;
}

.vk-mail a {
    color: #3f8ae0;
}

.vk-mail .portal-menu {
    min-width: 500px;
}

.vk-mail.error-page_404 .ph-whiteline {
    min-width: 1000px;
}

@media all and (max-width: 920px) {
    .vk-mail .error-message {
        width: 500px;
    }

    .vk-mail .error-message__content {
        margin: 0 auto;
        display: block;
    }
}

a {
	color: #005BD1;
    text-decoration: none;
}

h1 {
	margin-top: 0px;
	margin-right: 0px;
	margin-bottom: 0px;
	margin-left: 0px;
	padding-top: 0px;
	padding-right: 0px;
	padding-bottom: 5px;
	padding-left: 0px;
	color: rgb(68, 68, 68);
	font-size: 17px;

}

.error-footer {
	font-size: 13px;
	text-align: center;
	line-height: 20px;
	color: #999999;
}

.error-message {
	width: 920px;
	position: relative;
	margin: 94px auto 0;
    padding-bottom: 28px;
	text-align: left;
}

	.error-message__body {
		padding-top: 25px;
		padding-right: 28px;
		padding-bottom: 14px;
		padding-left: 28px;
	}

	.error-message__img, .error-message__content {
		margin-top: 0px;
		margin-right: 28px;
		margin-bottom: 56px;
		margin-left: 28px;
		display: inline-block;
		vertical-align: middle;
	}

	.error-message__content {
		max-width: 400px;
		margin-bottom: 0px;
        margin-right: 0px;
		text-align: left;
		border: 1px solid rgb(217, 217, 217);
		background-color: rgb(255, 255, 255);
		border-radius: 4px;
		box-shadow: rgba(0, 0, 0, 0.09) 0px 0px 8px;
	}

	.error-message__footer {
		padding: 16px 28px;
	    background-color: rgb(228, 235, 240);
	    border-top: 1px solid rgb(218, 228, 239);
	}

	.error-message__heading {
		margin-bottom: 10px;
		padding-bottom: 0px;
		font-size: 22px;
		font-weight: normal;
		line-height: 24px;
	}


.error-message_sketch {
    width: 1000px;
    position: relative;
    padding: 94px 0;
    margin: 0 auto;
    text-align: left;
}

	.error-message__message {
		margin-top: 0px;
		margin-right: 0px;
		margin-bottom: 16px;
		margin-left: 0px;
		font-size: 14px;
		line-height: 20px;
	}

.page-error {
	padding-bottom: 64px;
	background-position: 100% 100%;
	background-repeat: no-repeat;
}

	.page-error__bg {
		min-height: 425px;
		padding-bottom: 35px;
		background-position: 100% 30px;
		background-repeat: no-repeat;
	}

	.page-error__body {
	    padding: 25px 46px 0;
	}

	.page-error__content {
		display: inline-block;
		vertical-align: middle;
		max-width: 520px;
		margin-bottom: 0;
		text-align: left;
	}

	.page-error__heading {
		font-size: 60px;
		font-weight: bold;
		color: #333333;
		text-align: left;
		line-height: 60px;
	    display: block;
	    margin: 0;
	    padding: 0 0 5px;
	}

	.page-error__message {
		margin: 32px 0;
		font-size: 17px;
		color: #333333;
		line-height: 24px;
	}



.btn {
	position: relative;
	display: inline-block;
	vertical-align: middle;
	line-height: 30px;
	margin: 0 8px 0 0;
	border: 1px solid rgba(0,0,0,0.12);
	padding: 0px 15px;
	cursor: pointer;
	font-family: inherit;
	font-size: 15px;
	-webkit-box-sizing: border-box;
	box-sizing: border-box;
	-webkit-border-radius: 2px;
	border-radius: 2px;
	-webkit-box-shadow: 0 2px 0 0 rgba(0, 0, 0, 0.04);
	box-shadow: 0 2px 0 0 rgba(0, 0, 0, 0.04);
	-webkit-user-select: none;
	-moz-user-select: none;
	-ms-user-select: none;
	user-select: none;
	outline: none;
}
	.btn_main {
		color: #ffffff;
		text-shadow: none;
		background-color: #005ff9;
	}

	.btn_main:hover {
		background-color: #005BEF;
	}

	.btn__text {
		font-family: Helvetica, Arial, Tahoma, Verdana, sans-serif;
	}

.portal-menu {
	min-width: 960px;
	border: none;
	z-index: 1000;
	margin-bottom: 0;
}

	.portal-menu_width {
		width: 95%;
		max-width: 1500px;
		margin: 0 auto;
		padding: 0;
	}

.pm-logo__link {
	display: block;
	height: 56px;
	padding-left: 72px;
}
	.pm-logo__link img {
		border: none; /* fix ie10 */
	}

			
		</style>
		<script nonce="<!--# echo var='csp_nonce' -->">
			/* begin: mrg-xray */

